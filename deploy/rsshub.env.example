# Copy this file to .env on the VPS and fill in real values.
# Do not commit the real .env file.

# Protects routes when RSSHub is exposed through a reverse proxy.
ACCESS_KEY=replace-with-a-long-random-string

# RSSHub Twitter route config. Prefer a non-important X account.
TWITTER_USERNAME=your_x_login
TWITTER_PASSWORD=your_x_password

# Optional. Use the TOTP secret, not a one-time 6 digit code.
# TWITTER_AUTHENTICATION_SECRET=your_totp_secret
